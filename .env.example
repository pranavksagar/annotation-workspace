# Annotation workspace configuration (all optional except DATABASE_URL in production).
DATABASE_URL=postgresql://annotation:annotation@127.0.0.1:55432/annotation
# Comma-separated; mutating requests from any other Origin are rejected.
APP_PUBLIC_ORIGIN=http://127.0.0.1:5174,http://localhost:5174
TRUSTED_HOSTS=127.0.0.1,localhost
# Serve the built frontend from the API process. The container image sets this to /app/dist/review.
FRONTEND_DIST=
# Port deploy/start.sh listens on in the container (Render sets PORT itself; default 8000).
# PORT=8000
# On Render, deploy/start.sh derives APP_PUBLIC_ORIGIN and TRUSTED_HOSTS from RENDER_EXTERNAL_URL / _HOSTNAME.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
# Limits (initial operating limits to validate against real drawings, not measured capacity).
MAX_UPLOAD_BYTES=52428800
MAX_PDF_PAGES=100
MAX_PAGE_PIXELS=64000000
MAX_RENDER_ASSET_BYTES=41943040
MAX_TOTAL_RENDER_BYTES=1073741824
RENDER_DPI=300
RENDER_TIMEOUT_SECONDS=120
RENDER_MEMORY_LIMIT_MIB=4096
# Editing lease
EDIT_LEASE_SECONDS=90
EDIT_HEARTBEAT_SECONDS=20
# Preparation worker
WORKER_POLL_SECONDS=2
WORKER_HEARTBEAT_SECONDS=10
WORKER_LEASE_SECONDS=60
WORKER_MAX_ATTEMPTS=3
WORKER_CONCURRENCY=1
# Mutation limits
MAX_BATCH_OPERATIONS=200
MAX_BATCH_BYTES=2097152
MAX_REGIONS_PER_DRAWING=50000
MAX_GROUPS_PER_DRAWING=10000
MAX_CONCURRENT_ASSET_READS=4
# OCR suggestions: a read-only text guess for each new box (needs the tesseract binary; brew/apt install tesseract).
ENABLE_OCR_SUGGESTIONS=false
OCR_TIMEOUT_SECONDS=10
OCR_MAX_CROP_PIXELS=4000000
OCR_CONCURRENCY=2
OCR_LANGUAGE=eng
